#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
# After building, a list of all of the config files that are used can be found
# at the top of:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/mapphone_defconfig
#
# The actual output of the kernel configuration system can be found at:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/.config
#
# You can check the .config file to verify that your configuration option is
# being set as expected.
#
CONFIG_MMI_DEVICE_DTBS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_PMSG=y
# CONFIG_PSTORE_DEFLATE_COMPRESS is not set
CONFIG_HZ_300=y
# CONFIG_SERIAL_MSM_GENI_CONSOLE is not set
CONFIG_DIAG_OVER_TTY=y
CONFIG_USB_USBNET=y
CONFIG_USB_UAS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# CONFIG_NFC_NQ is not set
# CONFIG_SMB1355_SLAVE_CHARGER is not set
# CONFIG_EXT4_USE_FOR_EXT2 is not set
# CONFIG_EXT4_USE_FOR_EXT3 is not set
# CONFIG_TOUCHSCREEN_FTS is not set
# CONFIG_TOUCHSCREEN_NT36XXX is not set
# CONFIG_TOUCHSCREEN_ST is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM is not set
# CONFIG_FPR_FPC is not set
CONFIG_DUAL_ROLE_USB_INTF=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_ZRAM_DEDUP=y
CONFIG_ION_POOL_FILL_MARK=16
CONFIG_DEBUG_BUGVERBOSE=n
# CONFIG_SLAB_MERGE_DEFAULT is not set

CONFIG_QCA_CLD_WLAN=m
CONFIG_CAMERA_CCI_DEBUG_INTF=m
CONFIG_EXFAT_FS=m
CONFIG_MMI_ANNOTATE=m
CONFIG_MMI_INFO=m
CONFIG_MMI_SYS_TEMP=m
CONFIG_MOTO_UTAGS=m
CONFIG_QPNP_ADAPTIVE_CHARGE=m
CONFIG_SENSORS_CLASS=m
CONFIG_SENSORS_SSC=y

CONFIG_RMNET_PERF=y
CONFIG_RMNET_SHS=y
# CONFIG_USB_GSPCA is not set

CONFIG_ZRAM_WRITEBACK=y

# CONFIG_SECURITY_SMACK is not set

# BBR (22.09): CONFIG_TCP_CONG_BBR i CONFIG_NET_SCH_FQ już istnieją w Kconfig tego jądra
# (net/ipv4/Kconfig, net/sched/Kconfig), tylko wyłączone w obu defconfigach — czysta flaga,
# kod BBR w mainline od 4.9. fq wymagane dla poprawnego pacingu BBR. Domyślny kongestion
# control to choice (net/ipv4/Kconfig :493 if TCP_CONG_ADVANCED) — nie zwykły string, stąd
# TCP_CONG_ADVANCED=y + DEFAULT_BBR=y, nie CONFIG_DEFAULT_TCP_CONG="bbr" (to pole wyliczane).
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y

# KernelSU-Next (legacy, manual hooks; kprobes w tym jądrze nie są włączone)
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KSU_KPROBES_HOOK is not set
# CONFIG_KSU_DEBUG is not set

# Wydajność (25.09, decyzja: build ma być jak najszybszy na starym telefonie z minimalnym dostępem do sieci):
# - zram: lz4 zamiast zstd z bengal-perf_defconfig — szybsza kompresja/dekompresja (lib/lz4 ma w tym jądrze
#   akcelerację ARMv8 asm), kosztem słabszej kompresji. Algorytmu nie ustawia żaden skrypt: LineageOS włącza
#   zram z fstab (swapon_all w init.mmi.rc), więc decyduje domyślna wartość jądra.
# - CFI (Clang Control Flow Integrity) wyłączone: sprawdzanie każdego wywołania pośredniego w jądrze kosztuje
#   kilka % na gorących ścieżkach; w zamian słabsza ochrona przed exploitami jądra. VINTF i tak nie jest
#   egzekwowane (PRODUCT_OTA_ENFORCE_VINTF_KERNEL_REQUIREMENTS := false w drzewie sm6225-common).
CONFIG_ZRAM_DEFAULT_COMP_ALGORITHM="lz4"
# CONFIG_CFI_CLANG is not set
